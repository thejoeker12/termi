#!/usr/bin/env zsh
# termi — print a random quote from the shared bucket when a new terminal opens.
# Sourcing this file loads functions without running main (see exec guard at bottom).
emulate -L zsh
zmodload zsh/datetime

# The one and only quote source. Point this somewhere else and reinstall to switch buckets.
TERMI_URL="https://jl-termi-quotes-2026.s3.eu-west-2.amazonaws.com/quotes.txt"

: ${XDG_CACHE_HOME:=$HOME/.cache}
TERMI_CACHE="$XDG_CACHE_HOME/termi/quotes.txt"

# ANSI green. Split out from the tty check so the colouring itself is testable.
termi_green() { print -r -- $'\e[32m'"$1"$'\e[0m'; }

# Colour only for a human at a terminal; a pipe or a file gets plain text, so
# `termi | cat` and $(termi) stay clean. This is a display choice only — unlike
# the rc snippets, which use [[ -o interactive ]] so the quote never vanishes.
termi_print_quote() {
  if [[ -t 1 ]]; then
    termi_green "$1"
  else
    print -r -- "$1"
  fi
}

# Print one random non-empty line from $1. Returns 1 if none available.
termi_pick_random_line() {
  [[ -f "$1" && -r "$1" ]] || return 1
  local -a lines
  # canonical zsh split-into-lines; unquoted expansion drops empty lines
  lines=(${(f)"$(<$1)"})
  (( $#lines > 0 )) || return 1
  # RANDOM is 15-bit; combine two draws so files >32767 lines stay reachable
  local idx=$(( ((RANDOM << 15) | RANDOM) % $#lines + 1 ))
  termi_print_quote "${lines[idx]}"
}

# Download the bucket into the cache. Atomic tmp+mv: a failed or empty download
# never replaces a good cache. Intended to run disowned in the background.
termi_refresh_cache() {
  command -v curl >/dev/null 2>&1 || return 0
  mkdir -p -- "${TERMI_CACHE:h}"
  local tmp="$TERMI_CACHE.tmp.$$"
  if curl -fsSL --max-time 10 "$TERMI_URL" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    mv -f -- "$tmp" "$TERMI_CACHE"
  else
    rm -f -- "$tmp"
  fi
}

termi_main() {
  # Two shells opened the same second must not print the same quote
  RANDOM=$(( $$ ^ EPOCHSECONDS ))
  # Refresh on every run. Disowned + all output to /dev/null: never blocks startup,
  # and never holds open the stdout pipe of a $(termi) command substitution.
  ( termi_refresh_cache ) > /dev/null 2>&1 &!
  # Prints what the last run downloaded; silent on a machine that has never fetched.
  termi_pick_random_line "$TERMI_CACHE" || return 0
}

# Run only when executed; `source bin/termi` (tests) just loads functions.
# Executed script => zsh_eval_context ends in "toplevel"; sourced => "file".
if [[ "${zsh_eval_context[-1]}" != file ]]; then
  termi_main "$@"
fi
